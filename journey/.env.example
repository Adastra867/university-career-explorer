# Server-only configuration. Never place these values in browser JavaScript.
# pnpm start loads the root .env; deployment/PowerShell environment takes precedence.
# DeepSeek defaults checked against its official model/API docs on 2026-10-14.
# Leaving both key variables empty keeps DIY and local research available.
JOURNEY_AI_PROVIDER=deepseek
# JOURNEY_AI_* aliases, when set, take precedence over DEEPSEEK_* aliases.
# JOURNEY_AI_BASE_URL=https://api.deepseek.com
JOURNEY_AI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
JOURNEY_AI_ENABLED=true
JOURNEY_AI_MAX_OUTPUT_TOKENS=1500
JOURNEY_AI_TIMEOUT_MS=45000
# Set a separate random admin credential for POST /api/journey/ai/config/test.
# No public webpage may write the API key or model. With this empty, tests deny access.
JOURNEY_AI_ADMIN_TOKEN=
# Nonofficial DeepSeek-compatible gateways require an exact deployment-owned base
# URL allowlist. Leave empty normally. Never obtain this from request parameters.
JOURNEY_AI_ALLOWED_BASE_URLS=
# https://api-docs.deepseek.com/api/list-models/
# https://api-docs.deepseek.com/api/create-chat-completion/

# Optional live evidence search uses the project's existing Coze SDK credentials.
# Without Coze configuration, explicitly requested live search degrades to the KB.

# Optional shared signing secret for multiple server replicas. With no value,
# each server process uses a random secret: restarting invalidates old proposals.
# Signed proposals expire after 15 minutes; this does not enable cloud graph sync.
JOURNEY_AI_PROPOSAL_SECRET=
