PORT=5000
NODE_ENV=development
APP_ORIGIN=http://localhost:5000
TRUST_PROXY=false
# Set your own local password and use the same password in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-your-local-password
DATABASE_URL=postgresql://career:replace-with-your-local-password@localhost:55432/career
DATABASE_SSL=false
AUTO_MIGRATE=false
# Complete HTTPS URL of a compatible JSON chat-completions endpoint.
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Search/Fetch reuse LLM_API_KEY by default and are billed separately.
DEEPSEEK_SEARCH_ENABLED=true
# Optional separate DeepSeek search key:
# DEEPSEEK_SEARCH_API_KEY=
# Optional server-controlled API base (primarily used by tests):
# DEEPSEEK_TOOLS_BASE_URL=https://api.deepseek.com

# Conservative request quotas; failed attempts also count.
AI_DAILY_USER_LIMIT=50
AI_DAILY_TOTAL_LIMIT=500
