# Node.js 24+. Copy to .env; never commit real credentials.
PORT=5000
NODE_ENV=development
CAREER_DB_PATH=./data/career.sqlite
CAREER_PUBLIC_URL=http://localhost:5000
CAREER_TRUST_PROXY=false
CAREER_RETENTION_DAYS=90
CAREER_SESSION_DAYS=30
CAREER_AI_REQUESTS_PER_MINUTE=12
# Only required while running pnpm admin:init; remove password afterwards.
CAREER_ADMIN_USERNAME=
CAREER_ADMIN_PASSWORD=
CAREER_ADMIN_DISPLAY_NAME=
# Optional: uses existing JOURNEY_AI_* / DEEPSEEK_* when CAREER_AI_* unset.
CAREER_AI_PROVIDER=
CAREER_AI_BASE_URL=
CAREER_AI_API_KEY=
CAREER_AI_MODEL=
CAREER_AI_TIMEOUT_MS=45000
CAREER_AI_MAX_OUTPUT_TOKENS=3000
CAREER_AI_ENABLED=true
# Existing Journey and Coze job search configuration remains supported.
# JOURNEY_AI_PROVIDER=
# JOURNEY_AI_BASE_URL=
# JOURNEY_AI_API_KEY=
# JOURNEY_AI_MODEL=
# COZE_API_TOKEN=
